# =====================================================================
# SciVerify Environment Configuration Template
# Copy this file to backend/.env and insert your API keys
# =====================================================================

# 1. Groq API Key - Used by Person 1 for Audio & Speech Verification (Whisper-v3 + Llama-3.1)
# Obtain free from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 2. Google Gemini API Key - Used by Person 2 for Text Claim Reasoning & Fine-Tuning
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here
